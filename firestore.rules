rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role
          in ['owner', 'admin', 'staff'];
    }

    function validCitizen(uid) {
      return request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'phone', 'preferredLanguage',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.displayName is string
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.preferredLanguage in ['en', 'tn']
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt is string;
    }

    function validServiceRequest(uid) {
      return request.resource.data.keys().hasOnly([
          'citizenId', 'serviceId', 'serviceName', 'fullName', 'email',
          'phone', 'message', 'preferredLanguage', 'status',
          'createdAt', 'updatedAt', 'channel'
        ])
        && request.resource.data.keys().hasAll([
          'citizenId', 'serviceId', 'serviceName', 'fullName',
          'phone', 'message', 'status', 'createdAt'
        ])
        && request.resource.data.citizenId == uid
        && request.resource.data.serviceId is string
        && request.resource.data.serviceName is string
        && request.resource.data.fullName is string
        && request.resource.data.phone is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt is string;
    }

    // Public-facing Ministry configuration. Keep private staff data in other collections.
    match /ministrySettings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /ministryServices/{serviceId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    match /serviceGuides/{guideId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow read: if isAdmin() || resource.data.status == 'published';
      allow create, update, delete: if isAdmin();
    }

    // Citizen-owned profile and request history.
    match /citizens/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && validCitizen(uid);
      allow delete: if false;
    }

    match /serviceRequests/{requestId} {
      allow create: if signedIn() && validServiceRequest(request.auth.uid);
      allow read: if isAdmin()
        || (signedIn() && resource.data.citizenId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow create: if signedIn()
        && request.resource.data.citizenId == request.auth.uid
        && request.resource.data.serviceId is string
        && request.resource.data.requestedDate is string
        && request.resource.data.status == 'requested'
        && request.resource.data.createdAt is string;
      allow read: if isAdmin()
        || (signedIn() && resource.data.citizenId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Reception and walk-in queue. Citizens can create and follow only their own entry.
    match /queueEntries/{entryId} {
      allow create: if signedIn()
        && request.resource.data.citizenId == request.auth.uid
        && request.resource.data.status == 'waiting'
        && request.resource.data.serviceId is string
        && request.resource.data.createdAt is string;
      allow read: if isAdmin()
        || (signedIn() && resource.data.citizenId == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Staff operational records and audit history are never public.
    match /staffTasks/{taskId} {
      allow read, write: if isAdmin();
    }

    match /referrals/{referralId} {
      allow read, write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /citizenNotifications/{uid}/items/{notificationId} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // Staff roles are provisioned out-of-band by a trusted administrator.
    // Never let a client grant itself a staff or owner role.
    match /admins/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
